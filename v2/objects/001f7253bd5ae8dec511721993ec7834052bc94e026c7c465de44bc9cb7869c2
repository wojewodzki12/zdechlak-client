MainWindow
  id: zdechlakBootUpdateWindow
  !text: tr('ZDECHLAK')
  size: 440 230
  phantom: false
  @onEscape: modules.client_zdechlak_boot.onCancel()

  Label
    id: titleLabel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    height: 18
    text-align: center
    !text: tr('Checking for updates...')
    color: #e8c56a
    font: verdana-11px-rounded

  Label
    id: statusLabel
    anchors.top: titleLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 10
    margin-left: 12
    margin-right: 12
    height: 18
    text-align: center
    text-wrap: false
    !text: tr('Please wait...')
    color: #f0e6c8

  Label
    id: detailLabel
    anchors.top: statusLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    margin-left: 12
    margin-right: 12
    height: 32
    text-align: center
    text-wrap: true
    text-auto-resize: false
    !text: tr('')
    color: #c8c8c8
    font: verdana-11px-monochrome

  ProgressBar
    id: progressBar
    anchors.top: detailLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 12
    margin-left: 20
    margin-right: 20
    height: 16
    background-color: #4444ff
    percent: 0

  Button
    id: continueButton
    !text: tr('Continue')
    width: 100
    height: 22
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: 10
    visible: false
    @onClick: modules.client_zdechlak_boot.onContinue()
