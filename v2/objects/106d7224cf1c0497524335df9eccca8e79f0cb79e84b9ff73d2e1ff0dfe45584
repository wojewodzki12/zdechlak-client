ZdechlakShopOptionChoice < Button
  height: 40
  margin-top: 4
  text-align: center
  text-wrap: true
  text-auto-resize: false
  font: verdana-11px-rounded

ZdechlakShopOptionWindow < MainWindow
  id: zdechlakShopOptionWindow
  !text: tr('Select option')
  size: 420 360
  @onEscape: modules.game_zdechlak_shop.cancelOptionSelect()

  Label
    id: promptLabel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    text-wrap: true
    text-auto-resize: true
    color: #f0e6c8
    font: verdana-11px-rounded

  TextList
    id: choicesList
    vertical-scrollbar: choicesScrollBar
    anchors.top: promptLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: cancelButton.top
    margin-top: 8
    margin-bottom: 8
    padding: 2
    focusable: false
    clipping: true

  VerticalScrollBar
    id: choicesScrollBar
    anchors.top: choicesList.top
    anchors.bottom: choicesList.bottom
    anchors.right: choicesList.right
    step: 28
    pixels-scroll: true

  Button
    id: cancelButton
    !text: tr('Cancel')
    width: 100
    height: 24
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    @onClick: modules.game_zdechlak_shop.cancelOptionSelect()

ZdechlakShopCategory < Panel
  height: 28
  margin-top: 2
  focusable: false
  phantom: false

  Button
    id: button
    anchors.fill: parent
    text-align: left
    @onClick: modules.game_zdechlak_shop.onCategoryButtonClick(self)

    $checked:
      image-clip: 0 46 22 23
      text-offset: 1 1

  Label
    id: name
    anchors.fill: button
    margin-left: 8
    margin-right: 4
    text-align: left
    color: #f0e6c8
    font: verdana-11px-rounded
    phantom: true

ZdechlakShopSubCategory < ZdechlakShopCategory
  height: 26
  margin-left: 14
  margin-top: 1

ZdechlakShopOffer < Panel
  height: 56
  background: alpha
  focusable: true
  phantom: false

  $focus:
    background: #99999999

  Label
    id: icon
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-top: 4
    margin-bottom: 4
    margin-left: 2
    size: 48 48
    phantom: true
    image-smooth: false

  Label
    id: title
    anchors.left: icon.right
    anchors.right: infoButton.left
    anchors.top: parent.top
    margin-top: 4
    margin-left: 8
    margin-right: 8
    text-align: topleft
    color: white
    font: verdana-11px-rounded

  Label
    id: description
    anchors.top: prev.bottom
    anchors.left: icon.right
    anchors.right: infoButton.left
    anchors.bottom: parent.bottom
    margin-left: 8
    margin-right: 8
    text-align: topleft
    text-auto-resize: true
    text-wrap: true
    color: white
    font: verdana-11px-rounded

  Button
    id: infoButton
    !text: tr('INFO')
    height: 25
    width: 54
    anchors.verticalCenter: parent.verticalCenter
    anchors.right: buyButton.left
    margin-right: 6
    text-align: center
    visible: false

  Button
    id: buyButton
    !text: tr('BUY')
    height: 25
    width: 70
    anchors.verticalCenter: parent.verticalCenter
    anchors.right: parent.right
    margin-right: 10
    text-align: center

MainWindow
  id: zdechlakShopWindow
  !text: tr('ZDECHLAK SHOP')
  size: 760 500
  @onEscape: modules.game_zdechlak_shop.hide()

  Panel
    id: leftPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: statusLabel.top
    width: 210
    margin-bottom: 8

    Label
      id: balanceLabel
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      text-align: center
      !text: tr('Zdechlak Coins: -')
      color: #e8c56a
      font: verdana-11px-rounded

    Button
      id: buyCoinsButton
      !text: tr('BUY COINS')
      width: 170
      height: 22
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: balanceLabel.bottom
      margin-top: 8
      @onClick: modules.game_zdechlak_shop.buyPoints()

    Button
      id: refreshButton
      !text: tr('Refresh')
      width: 170
      height: 22
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: buyCoinsButton.bottom
      margin-top: 6
      @onClick: modules.game_zdechlak_shop.refresh()

    Label
      id: categoriesTitle
      anchors.top: refreshButton.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 10
      !text: tr('Categories')
      color: #c9a227
      font: verdana-11px-rounded

    VerticalScrollBar
      id: categoriesScrollBar
      anchors.top: categoriesTitle.bottom
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 4
      step: 28
      pixels-scroll: true

    Panel
      id: categories
      anchors.top: categoriesTitle.bottom
      anchors.left: parent.left
      anchors.right: categoriesScrollBar.left
      anchors.bottom: parent.bottom
      margin-top: 4
      margin-right: 2
      layout: verticalBox
      focusable: false
      clipping: true

  Panel
    id: rightPanel
    anchors.top: parent.top
    anchors.left: leftPanel.right
    anchors.right: parent.right
    anchors.bottom: statusLabel.top
    margin-left: 10
    margin-bottom: 8

    Panel
      id: bannerPanel
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 140
      image-source: /images/ui/panel_flat
      image-border: 4
      visible: true
      clipping: true

      Label
        id: bannerFallback
        anchors.fill: parent
        margin: 8
        text-align: center
        text-wrap: true
        !text: tr('ZDECHLAK SPECIAL OFFERS')
        color: #e8c56a
        font: verdana-11px-rounded
        phantom: true
        visible: true

      Label
        id: bannerImage
        anchors.fill: parent
        margin: 4
        phantom: true
        visible: false
        image-smooth: false

    Label
      id: productsTitle
      anchors.top: bannerPanel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6
      !text: tr('Products')
      color: #c9a227
      font: verdana-11px-rounded

    VerticalScrollBar
      id: productsScrollBar
      anchors.top: productsTitle.bottom
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 4
      step: 28
      pixels-scroll: true

    TextList
      id: products
      vertical-scrollbar: productsScrollBar
      anchors.top: productsTitle.bottom
      anchors.left: parent.left
      anchors.right: productsScrollBar.left
      anchors.bottom: parent.bottom
      margin-top: 4
      margin-right: 2
      padding: 1
      focusable: false
      clipping: true

  Label
    id: statusLabel
    anchors.bottom: closeButton.top
    anchors.left: parent.left
    anchors.right: closeButton.left
    margin-bottom: 8
    margin-right: 8
    height: 16
    !text: tr('Ready')
    color: #aaaaaa

  Button
    id: closeButton
    !text: tr('Close')
    width: 80
    height: 22
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    @onClick: modules.game_zdechlak_shop.hide()
