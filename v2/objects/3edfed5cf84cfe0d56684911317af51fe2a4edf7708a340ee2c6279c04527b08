UIWidget
  id: background
  anchors.fill: parent
  focusable: false
  background-color: black
  image-source: /images/background
  image-smooth: true
  image-fixed-ratio: false
  clipping: true

  UIWidget
    id: artwork
    anchors.fill: parent
    image-source: /images/background
    image-smooth: true
    image-fixed-ratio: false
    image-auto-resize: false
    focusable: false
    phantom: true

  UILabel
    id: clientVersionLabel
    background-color: #00000099
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    text-align: center
    text-auto-resize: false
    width: 220
    height: 90
    padding: 2
    color: #ffffff
    font: terminus-14px-bold
