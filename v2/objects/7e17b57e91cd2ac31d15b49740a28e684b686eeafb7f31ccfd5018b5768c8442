BossTrackerCompactRow < FlatPanel
  height: 28
  margin-bottom: 2
  padding-left: 4
  padding-right: 4

  Label
    id: nameLabel
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    font: verdana-11px-monochrome
    color: #ffdd88
    text-auto-resize: true

  Label
    id: statusLabel
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    font: verdana-11px-monochrome
    color: #88ff88
    text-align: topright
    text-auto-resize: true

MiniWindow
  id: bossTrackerWindow
  !text: tr('Boss Tracker')
  height: 160
  icon: /images/topbuttons/quest_tracker
  @onClose: modules.game_zdechlak_bosstracker.onMiniWindowClose()
  &save: true

  MiniWindowContents
    padding: 4
    layout:
      type: verticalBox

    Label
      id: hintLabel
      !text: tr('20h timer after confirmed death. Not a server respawn guarantee.')
      text-wrap: true
      text-auto-resize: true
      color: #888888
      font: verdana-11px-monochrome
      margin-bottom: 4

    Panel
      id: bossList
      layout:
        type: verticalBox
        fit-children: true
