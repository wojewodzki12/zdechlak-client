TopButton < UIButton
  size: 26 26
  image-source: /images/ui/button_top
  image-clip: 0 0 26 26
  image-border: 3
  image-color: #ffffffff
  icon-color: #ffffffff
  icon-clip: 0 0 20 20
  
  $on:
    image-source: /images/ui/button_top_blink
    icon-clip: 0 20 20 20

  $hover !disabled:
    image-color: #ffffff99
    image-clip: 26 0 26 26

  $pressed:
    image-clip: 52 0 26 26
    icon-clip: 0 20 20 20

  $disabled:
    image-color: #ffffff44
    icon-color: #ffffff44

TopToggleButton < UIButton
  size: 20 20
  image-source: /images/ui/button_top
  image-clip: 0 0 26 26
  image-color: #ffffffff
  image-border: 3
  icon-clip: 0 0 20 20
  icon-color: #ffffffff
  
  $on:
    icon-clip: 0 20 20 20

  $hover !disabled:
    image-color: #ffffff99
    image-clip: 26 0 26 26

  $pressed:
    image-clip: 52 0 26 26
    icon-clip: 0 20 20 20

  $disabled:
    image-color: #ffffff44
    icon-color: #ffffff44

// Options/Exit: icon then label side-by-side (text not drawn on the icon).
TopLabeledNavButton < Panel
  height: 28
  focusable: false
  phantom: false
  layout:
    type: horizontalBox
    spacing: 0
    fit-children: true
  padding: 0

  TopButton
    id: iconBtn
    size: 26 26
    phantom: true

  Label
    id: textLabel
    font: verdana-11px-rounded
    color: #eeeeee
    text-auto-resize: true
    text-align: left
    margin-left: 4
    margin-top: 6
    phantom: true

// Discord promo: crisp mark + short CTA, no button chrome under the glyph.
TopDiscordPromo < Panel
  height: 28
  focusable: false
  phantom: false
  layout:
    type: horizontalBox
    spacing: 0
    fit-children: true
  padding: 0

  UIWidget
    id: iconBtn
    size: 24 24
    margin-top: 2
    phantom: true
    image-source: /images/ui/discord
    image-smooth: true

  Label
    id: textLabel
    font: verdana-11px-rounded
    color: #e8c56a
    text-auto-resize: true
    text-align: left
    margin-left: 5
    margin-top: 6
    phantom: true

TopMenuButtonsPanel < Panel
  layout:
    type: horizontalBox
    spacing: 3
    fit-children: true
  padding: 4 3

TopMenuPanel < Panel
  height: 36
  image-source: /images/ui/panel_top
  image-repeated: true
  image-border: 3
  image-border-top: 0
  focusable: false

TopMenuFrameCounterLabel < Label
  font: verdana-11px-rounded
  color: white
  margin-top: 4
  margin-left: 5

TopMenuPingLabel < Label
  font: verdana-11px-rounded

TopSocialButton < UIButton
  size: 20 20
  margin-top: 8
  image-color: #ffffffff
  phantom: false
  padding: 0

  $hover !disabled:
    image-color: #ffffffcc

  $pressed:
    image-color: #ffffff99

TopMenu < TopMenuPanel
  id: topMenu
  width: 760
  anchors.horizontalCenter: parent.horizontalCenter
  anchors.top: parent.top
  &hideIngame: true
  &reverseButtons: true

  TopMenuButtonsPanel
    id: socialButtonsPanel
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    padding: 3 4

  TopMenuButtonsPanel
    id: rightButtonsPanel
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: prev.right

  TopMenuButtonsPanel
    id: rightGameButtonsPanel
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: prev.right
    visible: false

  // YT/IG/TikTok/FB sit in the middle of the bar, clear of Discord CTA on the left.
  TopMenuButtonsPanel
    id: centerSocialButtonsPanel
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    padding: 3 8
    layout:
      type: horizontalBox
      spacing: 8
      fit-children: true

  Label
    id: onlineLabel
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    text-align: center
    text-auto-resize: true

  TopMenuButtonsPanel
    id: leftButtonsPanel
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right

  TopMenuButtonsPanel
    id: leftGameButtonsPanel
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: prev.left
    visible: false
