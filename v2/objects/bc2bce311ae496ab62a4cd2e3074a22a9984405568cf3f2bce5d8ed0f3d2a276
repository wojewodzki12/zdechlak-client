PassSlot < Panel
  size: 34 34
  image-source: /images/ui/item
  focusable: false
  phantom: false

  UIItem
    id: item
    anchors.fill: parent
    virtual: true
    phantom: true

  Label
    id: badge
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-right: 1
    margin-bottom: 0
    font: verdana-9px-rounded
    color: #ffffff
    text-auto-resize: true
    phantom: true

PassNavButton < Button
  size: 20 34
  font: verdana-11px-rounded
  text-align: center

PassBarRoot < Panel
  id: zdechlakPassBar
  height: 56
  focusable: false
  phantom: false
  image-source: /images/ui/panel_flat
  image-border: 3
  image-color: #6a6a6a
  padding-left: 6
  padding-right: 8
  padding-top: 4
  padding-bottom: 4

  PassNavButton
    id: prevBtn
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 228
    text: <

  Panel
    id: slotsRow
    anchors.left: prevBtn.right
    anchors.top: parent.top
    margin-left: 4
    size: 376 34
    layout:
      type: horizontalBox
      spacing: 4

  PassNavButton
    id: nextBtn
    anchors.left: slotsRow.right
    anchors.top: parent.top
    margin-left: 4
    text: >

  Label
    id: currentLabel
    anchors.left: nextBtn.right
    anchors.right: plusPanel.left
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin-left: 10
    margin-right: 8
    text-align: left
    font: verdana-11px-rounded
    color: #f0e6c8
    text: -

  Panel
    id: plusPanel
    anchors.right: parent.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    width: 210
    focusable: false

    Button
      id: buyPassBtn
      anchors.top: parent.top
      anchors.right: parent.right
      size: 100 20
      font: verdana-11px-rounded
      text: BUY PASS+
      color: #1a1a1a
      background-color: #f0c040

    Label
      id: buyHint
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: buyPassBtn.bottom
      margin-top: 2
      text-align: right
      font: verdana-9px-rounded
      color: #d0d0d0
      text: Locked Pass+ rewards unlock instantly.

    Label
      id: daysLabel
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      text-align: right
      font: verdana-11px-rounded
      color: #f0c040
      text-auto-resize: true
      text: Pass+ 0d
      visible: false
