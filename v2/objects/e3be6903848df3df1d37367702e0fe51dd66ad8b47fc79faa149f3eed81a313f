-- ZDECHLAK login background.
-- background.png must be a COMPLETE PNG and within GL max texture size (use <=1920).
-- A truncated 2560x1440 tlo.png previously loaded as a blank texture.
local background
local artwork
local clientVersionLabel

local function applyArtwork()
  if not artwork then
    return
  end
  -- Prefer packaged /images/background (layout-aware). Fallback path kept for older trees.
  local ok = pcall(function()
    artwork:setImageSource('/images/background')
  end)
  if not ok then
    pcall(function()
      artwork:setImageSource('/modules/client_background/tlo')
    end)
  end
  pcall(function()
    artwork:fill('parent')
  end)
  -- Also paint the root widget so a black frame never shows if child fails.
  if background then
    pcall(function()
      background:setImageSource('/images/background')
    end)
  end
end

function init()
  background = g_ui.displayUI('background')
  background:lower()
  artwork = background:getChildById('artwork')
  clientVersionLabel = background:getChildById('clientVersionLabel')
  clientVersionLabel:setText('ZDECHLAK v1.0\nzdechlak.pl\nOTClient')

  applyArtwork()
  -- Re-apply after first layout pass (geometry ready).
  addEvent(applyArtwork)
  scheduleEvent(applyArtwork, 50)

  if not g_game.isOnline() then
    addEvent(function() g_effects.fadeIn(clientVersionLabel, 1500) end)
  end

  connect(g_game, { onGameStart = hide })
  connect(g_game, { onGameEnd = show })
end

function terminate()
  disconnect(g_game, { onGameStart = hide })
  disconnect(g_game, { onGameEnd = show })
  g_effects.cancelFade(background:getChildById('clientVersionLabel'))
  background:destroy()
  Background = nil
end

function hide()
  background:hide()
end

function show()
  background:show()
  applyArtwork()
end

function hideVersionLabel()
  background:getChildById('clientVersionLabel'):hide()
end

function setVersionText(text)
  clientVersionLabel:setText(text)
end

function getBackground()
  return background
end
