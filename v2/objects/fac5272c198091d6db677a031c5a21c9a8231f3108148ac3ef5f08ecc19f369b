function safeBotCall(func)
  local status, result = pcall(func)
  if not status then    
    onError(result)
  end
end

local function eachExecutor(fn)
  if botExecutor then
    safeBotCall(function() fn(botExecutor) end)
  end
  if analyzerExecutor then
    safeBotCall(function() fn(analyzerExecutor) end)
  end
end

function botKeyDown(widget, keyCode, keyboardModifiers)
  if not botExecutor and not analyzerExecutor then return false end
  if keyCode == KeyUnknown then return end
  eachExecutor(function(ex) ex.callbacks.onKeyDown(keyCode, keyboardModifiers) end)
end

