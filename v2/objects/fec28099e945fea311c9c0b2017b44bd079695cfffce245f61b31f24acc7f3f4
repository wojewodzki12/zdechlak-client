-- In-client update gate for ZDECHLAK.
-- Visible progress lives in the real OTC window. Cryptographic install is done
-- by the native ZDECHLAK.exe helper/launcher process (status file IPC).

local POLL_MS = 250
local MAX_WAIT_MS = 15 * 60 * 1000

local bootWindow = nil
local pollEvent = nil
local startedAt = 0
local finished = false
local updateApplied = false

local function env(name)
  local ok, value = pcall(function()
    return os.getenv(name)
  end)
  if ok and value and value ~= '' then
    return value
  end
  return nil
end

local function bootEnabled()
  return env('ZDECHLAK_BOOT_UPDATE') == '1'
end

local function statusPath()
  return env('ZDECHLAK_UPDATE_STATUS')
end

local function setUi(title, status, percent, showContinue)
  if not bootWindow then
    return
  end
  local t = bootWindow:getChildById('titleLabel')
  local s = bootWindow:getChildById('statusLabel')
  local p = bootWindow:getChildById('progressBar')
  local b = bootWindow:getChildById('continueButton')
  if t then t:setText(title or '') end
  if s then s:setText(status or '') end
  if p and percent ~= nil then
    p:setPercent(math.max(0, math.min(100, tonumber(percent) or 0)))
  end
  if b then
    b:setVisible(showContinue and true or false)
  end
end

local function hideLogin()
  if EnterGame and EnterGame.hide then
    pcall(EnterGame.hide)
  end
  if CharacterList and CharacterList.hide then
    pcall(CharacterList.hide)
  end
end

local function showLogin()
  if bootWindow then
    bootWindow:hide()
  end
  if EnterGame and EnterGame.show then
    pcall(EnterGame.show)
  end
end

local function readStatus()
  local path = statusPath()
  if not path then
    return nil
  end
  -- Prefer reading via g_resources if mapped; else plain io.
  local ok, content = pcall(function()
    local f = io.open(path, 'rb')
    if not f then
      return nil
    end
    local data = f:read('*a')
    f:close()
    return data
  end)
  if not ok or not content or content == '' then
    return nil
  end
  local st, doc = pcall(function()
    return json.decode(content)
  end)
  if not st then
    return nil
  end
  return doc
end

local function finishGate(allowLogin, restart)
  if finished then
    return
  end
  finished = true
  if pollEvent then
    removeEvent(pollEvent)
    pollEvent = nil
  end
  if restart then
    setUi('Update ready', 'Restarting client to apply the signed update...', 100, false)
    scheduleEvent(function()
      -- Signal native launcher to relaunch from the new active release.
      local marker = env('ZDECHLAK_RESTART_MARKER')
      if marker then
        pcall(function()
          local f = io.open(marker, 'wb')
          if f then
            f:write('{"restart":true}\n')
            f:close()
          end
        end)
      end
      g_app.exit()
    end, 400)
    return
  end
  if allowLogin then
    showLogin()
  else
    setUi('Update error', 'Could not finish update check. You can continue offline.', 100, true)
  end
end

local function poll()
  if finished then
    return
  end
  if (os.time() - startedAt) * 1000 > MAX_WAIT_MS then
    finishGate(true, false)
    return
  end
  local doc = readStatus()
  if not doc then
    setUi('Checking for updates', 'Waiting for updater...', 5, false)
    pollEvent = scheduleEvent(poll, POLL_MS)
    return
  end
  local phase = tostring(doc.phase or '')
  local message = tostring(doc.message or '')
  local percent = tonumber(doc.percent or 0) or 0
  if phase == 'error' then
    setUi('Update check failed', message ~= '' and message or 'Updater error', percent, true)
    updateApplied = false
    -- Allow login with previously verified local release.
    finished = true
    return
  end
  if phase == 'done' then
    updateApplied = doc.updated == true
    if updateApplied then
      finishGate(false, true)
    else
      setUi('Up to date', message ~= '' and message or 'No update required.', 100, false)
      scheduleEvent(function()
        finishGate(true, false)
      end, 350)
    end
    return
  end
  local title = 'Updating ZDECHLAK'
  if phase == 'checking' then title = 'Checking for updates' end
  if phase == 'downloading' then title = 'Downloading update' end
  if phase == 'verifying' then title = 'Verifying signatures' end
  setUi(title, message, percent, false)
  pollEvent = scheduleEvent(poll, POLL_MS)
end

function onContinue()
  showLogin()
end

function onCancel()
  -- Keep blocking until done/error; Escape does not skip a required restart.
  if finished and not updateApplied then
    showLogin()
  end
end

function init()
  if not bootEnabled() then
    return
  end
  startedAt = os.time()
  hideLogin()
  bootWindow = g_ui.displayUI('client_zdechlak_boot')
  if bootWindow then
    bootWindow:show()
    bootWindow:raise()
    bootWindow:focus()
  end
  setUi('Checking for updates', 'Starting signed update check...', 1, false)
  -- Keep login hidden while gate is active.
  scheduleEvent(hideLogin, 100)
  scheduleEvent(hideLogin, 500)
  pollEvent = scheduleEvent(poll, POLL_MS)
end

function terminate()
  if pollEvent then
    removeEvent(pollEvent)
    pollEvent = nil
  end
  if bootWindow then
    bootWindow:destroy()
    bootWindow = nil
  end
end
